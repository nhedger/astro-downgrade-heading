{
	"name": "astro-downgrade-heading",
	"version": "0.3.0",
	"description": "Astro integration and plugins for downgrading Markdown heading levels",
	"author": "Nicolas Hedger <nicolas@hedger.ch>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nhedger/astro-downgrade-heading.git"
	},
	"homepage": "https://github.com/nhedger/astro-downgrade-heading#readme",
	"bugs": {
		"url": "https://github.com/nhedger/astro-downgrade-heading/issues"
	},
	"keywords": [
		"markdown",
		"mdast",
		"satteri",
		"remark",
		"heading",
		"astro",
		"astro-integration",
		"withastro"
	],
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./satteri": {
			"types": "./dist/satteri.d.ts",
			"import": "./dist/satteri.js"
		},
		"./remark": {
			"types": "./dist/remark.d.ts",
			"import": "./dist/remark.js"
		}
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run build"
	},
	"peerDependencies": {
		"astro": "^7.0.0",
		"satteri": "^0.9.5"
	},
	"peerDependenciesMeta": {
		"astro": {
			"optional": true
		},
		"satteri": {
			"optional": true
		}
	},
	"dependencies": {
		"@types/mdast": "^4.0.4",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"astro": "^7.1.3",
		"git-cliff": "^2.13.1",
		"remark": "^15.0.1",
		"satteri": "^0.9.5",
		"tsdown": "^0.22.12",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@11.11.0"
}
